{
  "name": "@nightqueue/nq",
  "version": "0.7.0",
  "description": "Issues in, pull requests with proof out. A local queue of coding agents with a cockpit: queue a job in the Studio, watch it reproduce, root-cause, fix and prove the change phase by phase, and come back to a pull request with evidence. Runs on Claude Code, on your machine.",
  "license": "BUSL-1.1",
  "author": {
    "name": "Maykon Vinicius",
    "url": "https://github.com/maykonVinicius"
  },
  "private": false,
  "homepage": "https://nightqueue.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightqueue/nightqueue.git"
  },
  "bugs": {
    "url": "https://github.com/nightqueue/nightqueue/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "studio",
    "mcp",
    "agent",
    "queue",
    "memory",
    "cli",
    "plugin",
    "automation"
  ],
  "bin": {
    "nightqueue": "bin/nightqueue.mjs"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "plugin",
    "src",
    "studio/dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-timeout=240000 --disable-warning=ExperimentalWarning \"test/**/*.test.mjs\"",
    "test:shard": "node --test --test-timeout=240000 --disable-warning=ExperimentalWarning --test-shard=$TEST_SHARD \"test/**/*.test.mjs\"",
    "release:check": "npm test && node scripts/release-check.mjs",
    "studio:dev": "node scripts/studio-dev.mjs",
    "studio:typecheck": "tsc -p studio/tsconfig.json --noEmit",
    "studio:build": "npm run studio:typecheck && vite build --config studio/vite.config.mts && node scripts/studio-stamp.mjs write",
    "studio:demo": "node scripts/studio-demo.mjs",
    "studio:shots": "node scripts/studio-demo.mjs --capture"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
